# Application settings
DEBUG=true

# LiteLLM settings
# For GitHub Models, set a GitHub token here (do not commit real secrets)
LITELLM_API_KEY=your_github_token_here
# Use GitHub provider-prefixed model to avoid OpenAI Assistants v2 behavior
LITELLM_MODEL=github/gpt-4o-mini
# Use GitHub Models OpenAI-compatible endpoint
LITELLM_BASE_URL=https://models.github.ai/inference

# Weather API (for the demo feature)
WEATHER_API_KEY=your_weather_api_key_here